# Copy to .env and fill in. Never commit .env.
GNANI_API_KEY=            # app.gnani.ai/voice
GROQ_API_KEY=             # console.groq.com -> API Keys (free tier)
GEMINI_API_KEY=           # aistudio.google.com -> Get API key (optional)

# Which LLM brain: groq, groq:<model>, gemini, gemini:<model>, ollama, openai_compat, mock
KAVACH_LLM=groq:openai/gpt-oss-120b   # free tier; gpt-oss-20b is the backup
KAVACH_LLM_RPM=6          # Groq free tier is ~8k tokens/min (about 5-6 calls); raise on a paid key

# KAVACH_STT_MODEL=prisma-v3.0      # default is Prisma v2.5
# KAVACH_TTS_MODEL=timbre-v2.5

# openai_compat (e.g. vLLM serving Gnani Evon):
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=none
# KAVACH_LLM_MODEL=gnani/gnani-evon-v3.3-30B-A3B
